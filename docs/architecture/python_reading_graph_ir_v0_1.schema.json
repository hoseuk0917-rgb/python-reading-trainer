{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "python_reading_graph_ir_v0_1.schema.json",
  "title": "Python Reading Graph IR v0.1",
  "type": "object",
  "required": [
    "schema_version",
    "ir_type",
    "generator_version",
    "source",
    "authority",
    "primary_scope_id",
    "scopes",
    "lenses",
    "indexes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "ir_type": {
      "const": "python_reading_graph"
    },
    "generator_version": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "required": [
        "name",
        "language",
        "sha256",
        "line_count"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "language": {
          "const": "python"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "line_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "authority": {
      "type": "object"
    },
    "primary_scope_id": {
      "type": "string"
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "name",
          "qualified_name",
          "start_node_id",
          "end_node_id",
          "nodes",
          "edges",
          "summary"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "module",
              "function",
              "method"
            ]
          },
          "name": {
            "type": "string"
          },
          "qualified_name": {
            "type": "string"
          },
          "start_node_id": {
            "type": "string"
          },
          "end_node_id": {
            "type": "string"
          },
          "nodes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "kind",
                "semantic_role",
                "label",
                "code_span",
                "code",
                "facts",
                "confidence"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                },
                "semantic_role": {
                  "type": "string"
                },
                "label": {
                  "type": "object",
                  "required": [
                    "ko",
                    "en"
                  ],
                  "properties": {
                    "ko": {
                      "type": "string"
                    },
                    "en": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                },
                "code_span": {
                  "type": "object",
                  "required": [
                    "start_line",
                    "end_line"
                  ],
                  "properties": {
                    "start_line": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "end_line": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "additionalProperties": false
                },
                "code": {
                  "type": "string"
                },
                "facts": {
                  "type": "object",
                  "required": [
                    "reads",
                    "writes",
                    "calls"
                  ],
                  "properties": {
                    "reads": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "writes": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "calls": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "additionalProperties": false
                },
                "confidence": {
                  "enum": [
                    "exact",
                    "structural",
                    "inferred"
                  ]
                }
              },
              "additionalProperties": true
            }
          },
          "edges": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "from",
                "to",
                "edge_type",
                "role",
                "label",
                "confidence"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "from": {
                  "type": "string"
                },
                "to": {
                  "type": "string"
                },
                "edge_type": {
                  "const": "control"
                },
                "role": {
                  "type": "string"
                },
                "label": {
                  "type": "object",
                  "required": [
                    "ko",
                    "en"
                  ],
                  "properties": {
                    "ko": {
                      "type": "string"
                    },
                    "en": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                },
                "confidence": {
                  "enum": [
                    "exact",
                    "structural",
                    "inferred"
                  ]
                }
              },
              "additionalProperties": true
            }
          },
          "summary": {
            "type": "object"
          }
        },
        "additionalProperties": true
      }
    },
    "lenses": {
      "type": "object"
    },
    "indexes": {
      "type": "object",
      "required": [
        "calls",
        "data_dependencies"
      ],
      "properties": {
        "calls": {
          "type": "array"
        },
        "data_dependencies": {
          "type": "array"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
