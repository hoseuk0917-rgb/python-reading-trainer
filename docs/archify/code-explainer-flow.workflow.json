{
  "schema_version": 1,
  "diagram_type": "workflow",
  "meta": {
    "title": "Python Trainer Code Explainer",
    "subtitle": "Archify pilot for the current browser-side code reading flow",
    "animation": "trace",
    "visual_preset": "signal-flow",
    "quality_profile": "standard",
    "views": [
      {
        "id": "main-reading-flow",
        "label": "Code to explanation",
        "focus": ["code-input", "detect-language", "rule-analysis", "flow-model", "explanation", "archify-view"],
        "note": "Follow the primary learning path from pasted code to a visual explanation."
      },
      {
        "id": "safety-review",
        "label": "Warnings and review",
        "focus": ["flow-model", "warnings", "explanation"],
        "note": "See where the analyzer separates warning signals from the main explanation path."
      }
    ],
    "output": "src/pwa/archify/code-explainer-flow.html"
  },
  "lanes": [
    { "id": "learner", "label": "Learner Input" },
    { "id": "analysis", "label": "Static Analysis" },
    { "id": "presentation", "label": "Learning Output" }
  ],
  "mainPath": [
    "code-input",
    "detect-language",
    "rule-analysis",
    "flow-model",
    "explanation",
    "archify-view"
  ],
  "nodes": [
    {
      "id": "code-input",
      "lane": "learner",
      "col": 0,
      "type": "external",
      "label": "Pasted Code",
      "sublabel": "learner input"
    },
    {
      "id": "detect-language",
      "lane": "analysis",
      "col": 1,
      "type": "backend",
      "label": "Detect Lang",
      "sublabel": "auto or selected"
    },
    {
      "id": "rule-analysis",
      "lane": "analysis",
      "col": 2,
      "type": "backend",
      "label": "Rule Match",
      "sublabel": "steps + concepts"
    },
    {
      "id": "flow-model",
      "lane": "analysis",
      "col": 3,
      "type": "messagebus",
      "label": "Flow Model",
      "sublabel": "data + calls"
    },
    {
      "id": "warnings",
      "lane": "presentation",
      "col": 3,
      "type": "security",
      "label": "Warnings",
      "sublabel": "risk + caution"
    },
    {
      "id": "explanation",
      "lane": "presentation",
      "col": 4,
      "type": "backend",
      "label": "Explanation",
      "sublabel": "reading guidance"
    },
    {
      "id": "archify-view",
      "lane": "presentation",
      "col": 5,
      "type": "frontend",
      "label": "Archify View",
      "sublabel": "interactive map"
    }
  ],
  "edges": [
    {
      "id": "input-detect",
      "from": "code-input",
      "to": "detect-language",
      "variant": "default",
      "fromSide": "bottom",
      "toSide": "top",
      "route": "drop"
    },
    {
      "id": "detect-rules",
      "from": "detect-language",
      "to": "rule-analysis",
      "variant": "default"
    },
    {
      "id": "rules-flow",
      "from": "rule-analysis",
      "to": "flow-model",
      "variant": "emphasis"
    },
    {
      "id": "flow-warning",
      "from": "flow-model",
      "to": "warnings",
      "variant": "security",
      "fromSide": "bottom",
      "toSide": "top",
      "route": "drop"
    },
    {
      "id": "flow-explanation",
      "from": "flow-model",
      "to": "explanation",
      "variant": "emphasis",
      "fromSide": "bottom",
      "toSide": "top",
      "route": "drop"
    },
    {
      "id": "explanation-view",
      "from": "explanation",
      "to": "archify-view",
      "variant": "emphasis"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Pilot Boundary",
      "items": [
        "Existing code analysis rules remain unchanged",
        "Archify is evaluated first as a generated interactive artifact",
        "No AI call is required to render this typed IR"
      ]
    },
    {
      "dot": "emerald",
      "title": "Expansion Path",
      "items": [
        "Stable node IDs can support route and reach exploration",
        "The same source can produce HTML and static exports",
        "A later adapter can map trainer analysis data into typed IR"
      ]
    }
  ]
}
